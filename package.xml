<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>virtual_camera</name>
  <version>0.1.0</version>
  <description>Simulated camera feed streaming images as ROS 2 sensor_msgs/Image in Rust</description>
  <maintainer email="beyhy@artc.a-star.edu.sg">Bey Hao Yun</maintainer>
  <license>Apache-2.0</license>

  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>rosbridge_server</depend>
  <depend>rmw_cyclonedds_cpp</depend>

  <exec_depend>libopencv-dev</exec_depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
