# Ignore types of files and or folders
build/*
install/*
log/*
.vscode/*
lcov/*
*.png
*.jpeg
*.mkv
*.mp4

# Rust build artifacts
target/
**/*.rs.bk

# OMM architecture docs
.omm/

# Fuzzing plans & docs
docs/

# Ignore specific file
data/input_data
AMENT_IGNORE

# Fuzz artifacts
fuzz/target/
fuzz/coverage/

# Fuzz working corpus
fuzz/corpus/

# Fuzz seeds (regenerated at build/CI time via `cargo run --bin seeds`)
fuzz/seed_corpus/
